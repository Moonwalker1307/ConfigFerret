<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ConfigFerret.GoogleCloud</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>ConfigFerret.GoogleCloud</PackageId>
    <Version>0.2.0</Version>
    <Description>Google Cloud Secret Manager source for ConfigFerret: links configuration values to the Secret Manager secrets that set them (names, labels and version states by default, values only when asked), read through the Secret Manager REST API with Application Default Credentials.</Description>
    <PackageTags>configuration;provenance;google-cloud;gcp;secret-manager;secrets;debugging</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/Moonwalker1307/ConfigFerret</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <MicrosoftExtensionsVersion>10.0.15</MicrosoftExtensionsVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <MicrosoftExtensionsVersion>11.0.0</MicrosoftExtensionsVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The REST API is called with HttpClient and System.Text.Json. Google.Apis.Auth only finds Application Default
         Credentials and signs service account tokens, which is much lighter than the gRPC Secret Manager client. -->
    <PackageReference Include="Google.Apis.Auth" Version="1.78.0" />
    <ProjectReference Include="../ConfigFerret/ConfigFerret.csproj" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.404" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="ConfigFerret.GoogleCloud.Tests" />
    <InternalsVisibleTo Include="ConfigFerret.Fuzz" />
  </ItemGroup>

</Project>
