<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ConfigFerret.Aws</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>ConfigFerret.Aws</PackageId>
    <Version>0.2.0</Version>
    <Description>AWS source for ConfigFerret: links configuration values to the AWS Secrets Manager secrets (and JSON secret properties) and Systems Manager Parameter Store parameters that set them, read with the official AWS SDK.</Description>
    <PackageTags>configuration;provenance;aws;secrets-manager;parameter-store;ssm;secrets;debugging</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/Moonwalker1307/ConfigFerret</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <MicrosoftExtensionsVersion>10.0.15</MicrosoftExtensionsVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <MicrosoftExtensionsVersion>11.0.0</MicrosoftExtensionsVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The official AWS SDK handles request signing, the credential chain, profiles and regions. -->
    <ProjectReference Include="../ConfigFerret/ConfigFerret.csproj" />
    <PackageReference Include="AWSSDK.SecretsManager" Version="4.1.1" />
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" Version="4.1.1" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="ConfigFerret.Aws.Tests" />
    <InternalsVisibleTo Include="ConfigFerret.Fuzz" />
  </ItemGroup>

</Project>
