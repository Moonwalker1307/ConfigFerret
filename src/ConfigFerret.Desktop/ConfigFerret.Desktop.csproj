<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The ConfigFerret desktop app. It is released only as self-contained builds on GitHub Releases, by
    .github/workflows/desktop-release.yml on a desktop-v* tag. It must never be packed or pushed to nuget.org,
    so it is not packable and ci.yml's pack step leaves it out.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- One target framework: the app ships with its own runtime, so it doesn't need the libraries' net11.0 build. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>ConfigFerret.Desktop</RootNamespace>
    <AssemblyName>ConfigFerret.Desktop</AssemblyName>
    <Product>ConfigFerret</Product>
    <Version>0.1.0</Version>
    <IsPackable>false</IsPackable>
    <IsPublishable>true</IsPublishable>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Public types are fine in an app; the tests use them. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <AvaloniaVersion>12.1.6</AvaloniaVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ConfigFerret/ConfigFerret.csproj" />
    <ProjectReference Include="../ConfigFerret.GitHub/ConfigFerret.GitHub.csproj" />
    <ProjectReference Include="../ConfigFerret.Octopus/ConfigFerret.Octopus.csproj" />
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Condition="'$(StrykerBuild)' == 'true'">
    <!-- Stryker.NET compiles without Avalonia's source generator; see the stub. -->
    <Compile Include="../../tests/ConfigFerret.Desktop.Tests/Stryker/MainWindowStub.cs" Link="Stryker/MainWindowStub.cs" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/icon.ico" />
    <AvaloniaResource Include="../../assets/icon.png" Link="Assets/icon.png" />
    <AvaloniaResource Include="../../assets/logo.png" Link="Assets/logo.png" />
    <InternalsVisibleTo Include="ConfigFerret.Desktop.Tests" />
  </ItemGroup>

</Project>
