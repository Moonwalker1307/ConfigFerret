<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Text -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource CfText}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource CfMuted}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="Foreground" Value="{DynamicResource CfMuted}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.2" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource CfMono}" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="SelectableTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource CfText}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource CfAccentSoft}" />
  </Style>
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{DynamicResource CfAccent}" />
  </Style>

  <!-- Surfaces -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CfSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CfBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CfRadius}" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="Border.code">
    <Setter Property="Background" Value="{DynamicResource CfCode}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CfBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CfRadiusSmall}" />
    <Setter Property="Padding" Value="10,8" />
  </Style>

  <!-- Stat tiles -->
  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{DynamicResource CfSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CfBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CfRadius}" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="MinWidth" Value="128" />
  </Style>
  <Style Selector="Border.tile TextBlock.number">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Border.tile.good TextBlock.number">
    <Setter Property="Foreground" Value="{DynamicResource CfGood}" />
  </Style>
  <Style Selector="Border.tile.check TextBlock.number">
    <Setter Property="Foreground" Value="{DynamicResource CfAccent}" />
  </Style>
  <Style Selector="Border.tile.bad TextBlock.number">
    <Setter Property="Foreground" Value="{DynamicResource CfBad}" />
  </Style>

  <!-- Stat tiles are the table's filters: a tile is a button, the active one is outlined in orange. -->
  <Style Selector="Button.tilebutton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.tilebutton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.tilebutton:pointerover Border.tile">
    <Setter Property="Background" Value="{DynamicResource CfSurfaceHover}" />
  </Style>
  <Style Selector="Button.tilebutton.selected Border.tile">
    <Setter Property="Background" Value="{DynamicResource CfAccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CfAccent}" />
  </Style>
  <Style Selector="Button.tilebutton:disabled Border.tile">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!-- Column header filters -->
  <Style Selector="Button.headerfilter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.headerfilter PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource CfMuted}" />
  </Style>
  <Style Selector="Button.headerfilter:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CfSurfaceHover}" />
  </Style>
  <Style Selector="Button.headerfilter.active PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource CfAccent}" />
  </Style>
  <Style Selector="Button.menuitem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.menuitem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CfSurfaceHover}" />
  </Style>
  <Style Selector="Button.menuitem.checked">
    <Setter Property="Foreground" Value="{DynamicResource CfAccent}" />
  </Style>

  <!-- Chips: one colour per layer family -->
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Background" Value="{DynamicResource CfSurfaceRaised}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.chip.bad"><Setter Property="Background" Value="{DynamicResource CfBadSoft}" /></Style>
  <Style Selector="Border.chip.bad TextBlock"><Setter Property="Foreground" Value="{DynamicResource CfBad}" /></Style>
  <Style Selector="Border.rating.bad PathIcon"><Setter Property="Foreground" Value="{DynamicResource CfBad}" /></Style>
  <Style Selector="Border.chip.dotnet"><Setter Property="Background" Value="{DynamicResource CfKindDotnetSoft}" /></Style>
  <Style Selector="Border.chip.dotnet TextBlock"><Setter Property="Foreground" Value="{DynamicResource CfKindDotnet}" /></Style>
  <Style Selector="Border.chip.k8s"><Setter Property="Background" Value="{DynamicResource CfKindK8sSoft}" /></Style>
  <Style Selector="Border.chip.k8s TextBlock"><Setter Property="Foreground" Value="{DynamicResource CfKindK8s}" /></Style>
  <Style Selector="Border.chip.secret"><Setter Property="Background" Value="{DynamicResource CfKindSecretSoft}" /></Style>
  <Style Selector="Border.chip.secret TextBlock"><Setter Property="Foreground" Value="{DynamicResource CfKindSecret}" /></Style>
  <Style Selector="Border.chip.helm"><Setter Property="Background" Value="{DynamicResource CfKindHelmSoft}" /></Style>
  <Style Selector="Border.chip.helm TextBlock"><Setter Property="Foreground" Value="{DynamicResource CfKindHelm}" /></Style>
  <Style Selector="Border.chip.kustomize"><Setter Property="Background" Value="{DynamicResource CfKindKustomizeSoft}" /></Style>
  <Style Selector="Border.chip.kustomize TextBlock"><Setter Property="Foreground" Value="{DynamicResource CfKindKustomize}" /></Style>
  <Style Selector="Border.chip.github"><Setter Property="Background" Value="{DynamicResource CfKindGithubSoft}" /></Style>
  <Style Selector="Border.chip.github TextBlock"><Setter Property="Foreground" Value="{DynamicResource CfKindGithub}" /></Style>
  <Style Selector="Border.chip.octopus"><Setter Property="Background" Value="{DynamicResource CfKindOctopusSoft}" /></Style>
  <Style Selector="Border.chip.octopus TextBlock"><Setter Property="Foreground" Value="{DynamicResource CfKindOctopus}" /></Style>

  <!-- Icon squares on discovery cards -->
  <Style Selector="Border.iconbox">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource CfSurfaceRaised}" />
  </Style>
  <Style Selector="Border.iconbox PathIcon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
  </Style>
  <Style Selector="Border.iconbox.dotnet"><Setter Property="Background" Value="{DynamicResource CfKindDotnetSoft}" /></Style>
  <Style Selector="Border.iconbox.dotnet PathIcon"><Setter Property="Foreground" Value="{DynamicResource CfKindDotnet}" /></Style>
  <Style Selector="Border.iconbox.k8s"><Setter Property="Background" Value="{DynamicResource CfKindK8sSoft}" /></Style>
  <Style Selector="Border.iconbox.k8s PathIcon"><Setter Property="Foreground" Value="{DynamicResource CfKindK8s}" /></Style>
  <Style Selector="Border.iconbox.helm"><Setter Property="Background" Value="{DynamicResource CfKindHelmSoft}" /></Style>
  <Style Selector="Border.iconbox.helm PathIcon"><Setter Property="Foreground" Value="{DynamicResource CfKindHelm}" /></Style>
  <Style Selector="Border.iconbox.kustomize"><Setter Property="Background" Value="{DynamicResource CfKindKustomizeSoft}" /></Style>
  <Style Selector="Border.iconbox.kustomize PathIcon"><Setter Property="Foreground" Value="{DynamicResource CfKindKustomize}" /></Style>
  <Style Selector="Border.iconbox.github"><Setter Property="Background" Value="{DynamicResource CfKindGithubSoft}" /></Style>
  <Style Selector="Border.iconbox.github PathIcon"><Setter Property="Foreground" Value="{DynamicResource CfKindGithub}" /></Style>
  <Style Selector="Border.iconbox.octopus"><Setter Property="Background" Value="{DynamicResource CfKindOctopusSoft}" /></Style>
  <Style Selector="Border.iconbox.octopus PathIcon"><Setter Property="Foreground" Value="{DynamicResource CfKindOctopus}" /></Style>

  <!-- Secret ratings -->
  <Style Selector="Border.rating">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Border.rating TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Border.rating.good"><Setter Property="Background" Value="{DynamicResource CfGoodSoft}" /></Style>
  <Style Selector="Border.rating.good TextBlock"><Setter Property="Foreground" Value="{DynamicResource CfGood}" /></Style>
  <Style Selector="Border.rating.check"><Setter Property="Background" Value="{DynamicResource CfAccentSoft}" /></Style>
  <Style Selector="Border.rating.check TextBlock"><Setter Property="Foreground" Value="{DynamicResource CfAccent}" /></Style>
  <Style Selector="Border.rating.bad"><Setter Property="Background" Value="{DynamicResource CfBadSoft}" /></Style>
  <Style Selector="Border.rating.bad TextBlock"><Setter Property="Foreground" Value="{DynamicResource CfBad}" /></Style>
  <Style Selector="Border.stripe">
    <Setter Property="Width" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector="Border.stripe.good"><Setter Property="Background" Value="{DynamicResource CfGood}" /></Style>
  <Style Selector="Border.stripe.check"><Setter Property="Background" Value="{DynamicResource CfAccent}" /></Style>
  <Style Selector="Border.stripe.bad"><Setter Property="Background" Value="{DynamicResource CfBad}" /></Style>

  <!-- Problem severities -->
  <Style Selector="PathIcon.error"><Setter Property="Foreground" Value="{DynamicResource CfBad}" /></Style>
  <Style Selector="PathIcon.warning"><Setter Property="Foreground" Value="{DynamicResource CfWarn}" /></Style>
  <Style Selector="PathIcon.info"><Setter Property="Foreground" Value="{DynamicResource CfInfo}" /></Style>
  <Style Selector="PathIcon.dotnet"><Setter Property="Foreground" Value="{DynamicResource CfKindDotnet}" /></Style>
  <Style Selector="PathIcon.k8s"><Setter Property="Foreground" Value="{DynamicResource CfKindK8s}" /></Style>
  <Style Selector="PathIcon.helm"><Setter Property="Foreground" Value="{DynamicResource CfKindHelm}" /></Style>
  <Style Selector="PathIcon.kustomize"><Setter Property="Foreground" Value="{DynamicResource CfKindKustomize}" /></Style>
  <Style Selector="PathIcon.github"><Setter Property="Foreground" Value="{DynamicResource CfKindGithub}" /></Style>
  <Style Selector="PathIcon.octopus"><Setter Property="Foreground" Value="{DynamicResource CfKindOctopus}" /></Style>

  <!-- Provenance timeline -->
  <Style Selector="Border.node">
    <Setter Property="Background" Value="{DynamicResource CfSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CfBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Opacity" Value="0.62" />
  </Style>
  <Style Selector="Border.node.effective">
    <Setter Property="BorderBrush" Value="{DynamicResource CfAccent}" />
    <Setter Property="Background" Value="{DynamicResource CfAccentSoft}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Border.state">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="Background" Value="{DynamicResource CfSurfaceHover}" />
  </Style>
  <Style Selector="Border.state TextBlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource CfMuted}" />
  </Style>
  <Style Selector="Border.state.effective">
    <Setter Property="Background" Value="{DynamicResource CfAccent}" />
  </Style>
  <Style Selector="Border.state.effective TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource CfAccentText}" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource CfAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource CfAccentText}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,8" />
  </Style>
  <Style Selector="Button.accent /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CfAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource CfAccentText}" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CfAccentHover}" />
    <Setter Property="Foreground" Value="{DynamicResource CfAccentText}" />
  </Style>
  <Style Selector="Button.accent PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource CfAccentText}" />
  </Style>
  <Style Selector="Button.accent TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource CfAccentText}" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CfSurfaceHover}" />
  </Style>
  <Style Selector="Button.subtle">
    <Setter Property="Background" Value="{DynamicResource CfSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CfBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,7" />
  </Style>
  <Style Selector="Button.subtle:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CfSurfaceHover}" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource CfAccent}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.pill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Background" Value="{DynamicResource CfSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CfBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ToggleButton.pill:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CfAccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CfAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource CfAccent}" />
  </Style>

  <!-- Inputs -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinWidth" Value="150" />
  </Style>
  <Style Selector="TextBox.search">
    <Setter Property="Background" Value="{DynamicResource CfSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CfBorder}" />
    <Setter Property="Padding" Value="8,7" />
  </Style>

  <!-- Repository list -->
  <Style Selector="ListBox.repos">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.repos ListBoxItem">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ListBox.repos ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CfSurfaceHover}" />
  </Style>
  <Style Selector="ListBox.repos ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CfAccentSoft}" />
  </Style>
  <Style Selector="Border.avatar">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource CfSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CfBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ListBox.repos ListBoxItem:selected Border.avatar">
    <Setter Property="Background" Value="{DynamicResource CfAccent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CfAccent}" />
  </Style>
  <Style Selector="ListBox.repos ListBoxItem:selected Border.avatar TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource CfAccentText}" />
  </Style>

  <!-- Plain lists inside cards -->
  <Style Selector="ListBox.plain">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.plain ListBoxItem">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ListBox.plain ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CfSurfaceHover}" />
  </Style>

  <!-- Tabs -->
  <Style Selector="TabControl.main">
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="TabControl.main TabItem">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="12,0" />
  </Style>
  <Style Selector="TabControl.main TabItem:selected /template/ Border#PART_SelectedPipe">
    <Setter Property="Background" Value="{DynamicResource CfAccent}" />
  </Style>
  <Style Selector="Border.count">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="Background" Value="{DynamicResource CfSurfaceRaised}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.count TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource CfMuted}" />
  </Style>
  <Style Selector="Border.count.bad">
    <Setter Property="Background" Value="{DynamicResource CfBadSoft}" />
  </Style>
  <Style Selector="Border.count.bad TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource CfBad}" />
  </Style>

  <!-- Data grid -->
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource CfBorder}" />
    <Setter Property="RowBackground" Value="Transparent" />
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="Foreground" Value="{DynamicResource CfMuted}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource CfAccent}" />
    <Setter Property="Opacity" Value="0.16" />
  </Style>
  <Style Selector="DataGridCell">
    <Setter Property="Padding" Value="10,0" />
  </Style>

  <!-- Overlays -->
  <Style Selector="Border.scrim">
    <Setter Property="Background" Value="#99000000" />
  </Style>
  <Style Selector="Border.dialog">
    <Setter Property="Background" Value="{DynamicResource CfSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CfBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="24" />
    <Setter Property="BoxShadow" Value="0 24 64 0 #66000000" />
  </Style>
</Styles>
