<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The ConfigFerret web app: the desktop app's screens as a website, for running in a Docker container. It is released
    only as a container image on GitHub (ghcr.io), by .github/workflows/web-release.yml on a web-v* tag. It must never be
    packed or pushed to nuget.org, so it is not packable and ci.yml's pack step leaves it out.

    It has no logic of its own for scanning or tracing. It compiles the desktop app's model, services, view models and
    credential stores (everything there but the Avalonia views) and renders the same view model with Blazor.
  -->
  <PropertyGroup>
    <!-- One target framework: the image ships with its own runtime, so it doesn't need the libraries' net11.0 build. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>ConfigFerret.Web</RootNamespace>
    <AssemblyName>ConfigFerret.Web</AssemblyName>
    <Product>ConfigFerret</Product>
    <Version>0.1.0</Version>
    <IsPackable>false</IsPackable>
    <IsPublishable>true</IsPublishable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Public types are fine in an app; the tests use them. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ConfigFerret/ConfigFerret.csproj" />
    <ProjectReference Include="../ConfigFerret.GitHub/ConfigFerret.GitHub.csproj" />
    <ProjectReference Include="../ConfigFerret.Octopus/ConfigFerret.Octopus.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- The desktop app's code, shared as source. Only the Avalonia views stay in the desktop app. -->
  <ItemGroup>
    <Compile Include="../ConfigFerret.Desktop/Model/**/*.cs" Link="Desktop/Model/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../ConfigFerret.Desktop/Services/**/*.cs" Link="Desktop/Services/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../ConfigFerret.Desktop/ViewModels/**/*.cs" Link="Desktop/ViewModels/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../ConfigFerret.Desktop/Credentials/**/*.cs" Link="Desktop/Credentials/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Shared/JsonApi.cs" Link="Shared/JsonApi.cs" />
  </ItemGroup>

  <!-- The logo and icon, served from the root of the site. -->
  <ItemGroup>
    <EmbeddedResource Include="../../assets/icon.png" LogicalName="brand/icon.png" />
    <EmbeddedResource Include="../../assets/logo.png" LogicalName="brand/logo.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ConfigFerret.Web.Tests" />
  </ItemGroup>

</Project>
