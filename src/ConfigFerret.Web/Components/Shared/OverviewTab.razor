<div class="scroll pad-top">
    <div class="caption">FOUND IN THE REPOSITORY</div>
    <div class="cards">
        @foreach (var card in Vm.Discoveries)
        {
            <div class="card discovery">
                <span class="iconbox @card.Css"><Icon Name="@card.Icon" /></span>
                <div class="discovery-text">
                    <div class="discovery-title">
                        <span class="bold">@card.Title</span>
                        @if (card.Used)
                        {
                            <span class="chip @card.Css">@card.State</span>
                        }
                    </div>
                    <div class="muted small">@card.Detail</div>
                </div>
            </div>
        }
    </div>
    @if (Vm.ProblemCount > 0)
    {
        <div class="caption notes">NOTES</div>
    }
    <ul class="problems">
        @foreach (var problem in Vm.Problems)
        {
            <li class="problem @problem.Severity">
                <Icon Name="@(problem.Severity is "error" or "warning" ? "IconAlert" : "IconInfo")" Size="14" Class="@problem.Severity" />
                <span>@problem.Text</span>
            </li>
        }
    </ul>
</div>

@code {
    /// <summary>The view model.</summary>
    [Parameter, EditorRequired]
    public required MainWindowViewModel Vm { get; set; }
}
