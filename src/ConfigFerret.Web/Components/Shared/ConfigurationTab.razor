<div class="config pad-top">
    <div class="filters">
        <label class="search wide">
            <Icon Name="IconSearch" Size="14" Class="muted" />
            <input type="search" placeholder="Search keys, values and sources" aria-label="Search keys, values and sources" value="@Vm.FilterText"
                   @oninput="e => Vm.FilterText = (string?)e.Value" />
        </label>
        <select aria-label="Layer" value="@LayerIndex" @onchange="OnLayerChanged">
            @for (var i = 0; i < Vm.LayerFilters.Count; i++)
            {
                <option value="@i">@Vm.LayerFilters[i]</option>
            }
        </select>
        <button class="pill @(Vm.OnlyOverridden ? "checked" : null)" aria-pressed="@(Vm.OnlyOverridden ? "true" : "false")" @onclick="() => Vm.OnlyOverridden = !Vm.OnlyOverridden">Overridden</button>
        <button class="pill @(Vm.OnlySecrets ? "checked" : null)" aria-pressed="@(Vm.OnlySecrets ? "true" : "false")" @onclick="() => Vm.OnlySecrets = !Vm.OnlySecrets">Secrets</button>
        <button class="pill @(Vm.OnlyDeadSettings ? "checked" : null)" aria-pressed="@(Vm.OnlyDeadSettings ? "true" : "false")" title="Settings no code reads" @onclick="() => Vm.OnlyDeadSettings = !Vm.OnlyDeadSettings">Dead</button>
        <button class="link" @onclick="() => Vm.ClearFiltersCommand.Execute(null)">Clear</button>
        <span class="muted">@Vm.ShownText</span>
    </div>

    <div class="config-split">
        <div class="card grid-card">
            <div class="grid-row grid-head" role="row">
                @foreach (var (column, label) in Columns)
                {
                    <button class="grid-sort" role="columnheader" aria-sort="@AriaSort(column)" @onclick="() => SortBy(column)">
                        @label @(_sort == column ? (_descending ? "▼" : "▲") : string.Empty)
                    </button>
                }
            </div>
            <div class="grid-body" role="rowgroup">
                <Virtualize Items="SortedRows" ItemSize="40" Context="row">
                    <button class="grid-row @(ReferenceEquals(row, Vm.SelectedRow) ? "selected" : null)" role="row" @onclick="() => Vm.SelectedRow = row">
                        <span class="cell key">
                            <span class="mono bold ellipsis">@row.Key</span>
                            @if (row.IsDead)
                            {
                                <span class="chip bad" title="@row.DeadReason">dead</span>
                            }
                        </span>
                        <span class="cell">
                            @if (row.IsSensitive)
                            {
                                <Icon Name="IconLock" Size="11" Class="kind-secret" />
                            }
                            <span class="mono ellipsis">@row.Value</span>
                        </span>
                        <span class="cell" title="@row.Story"><span class="ellipsis">@row.ComesFrom</span></span>
                        <span class="cell chips">
                            @foreach (var kind in row.Kinds)
                            {
                                <span class="chip @kind.Css">@kind.Label</span>
                            }
                        </span>
                    </button>
                </Virtualize>
            </div>
        </div>

        <div class="card details">
            @if (Vm.SelectedRow is { } selected)
            {
                <div class="caption">SETTING</div>
                <div class="mono detail-key">@selected.Key</div>
                <pre class="code mono">@selected.Value</pre>
                @if (Vm.SelectedSecret is { } secret)
                {
                    <span class="rating @secret.Css" title="@secret.Reason"><Icon Name="IconShield" Size="12" /> @secret.Label</span>
                    <p class="muted">@secret.Reason</p>
                }
                @if (selected.IsDead)
                {
                    <span class="rating bad"><Icon Name="IconSleep" Size="12" /> Dead: not read by code</span>
                    <p class="muted">@selected.DeadReason. Safe to delete once no other environment or app reads it.</p>
                }
                <div class="caption">STORY</div>
                <p class="story">@selected.Story</p>
                <div class="caption">LAYERS, LOWEST PRIORITY FIRST</div>
                <StepTree Nodes="Vm.Details" />
            }
            else
            {
                <div class="empty"><span class="muted">Pick a setting to see where its value comes from.</span></div>
            }
        </div>
    </div>
</div>

@code {
    private static readonly (string Column, string Label)[] Columns = [("key", "KEY"), ("value", "VALUE"), ("from", "COMES FROM"), ("layers", "LAYERS")];
    private string? _sort;
    private bool _descending;

    /// <summary>The view model.</summary>
    [Parameter, EditorRequired]
    public required MainWindowViewModel Vm { get; set; }

    private int LayerIndex => Vm.SelectedLayerFilter is { } filter ? Math.Max(0, IndexOf(filter)) : 0;

    private List<SettingRow> SortedRows
    {
        get
        {
            Func<SettingRow, IComparable> key = _sort switch
            {
                "key" => r => r.Key,
                "value" => r => r.Value,
                "from" => r => r.ComesFrom,
                "layers" => r => r.LayerCount,
                _ => _ => 0,
            };
            if (_sort is null)
            {
                return [.. Vm.Rows];
            }

            var comparer = Comparer<IComparable>.Create((a, b) => a is string x && b is string y ? string.Compare(x, y, StringComparison.OrdinalIgnoreCase) : a.CompareTo(b));
            return _descending ? [.. Vm.Rows.OrderByDescending(key, comparer)] : [.. Vm.Rows.OrderBy(key, comparer)];
        }
    }

    private int IndexOf(LayerFilter filter)
    {
        for (var i = 0; i < Vm.LayerFilters.Count; i++)
        {
            if (Vm.LayerFilters[i] == filter)
            {
                return i;
            }
        }

        return -1;
    }

    private void OnLayerChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value as string, System.Globalization.NumberStyles.None, CultureInfo.InvariantCulture, out var index) && index >= 0 && index < Vm.LayerFilters.Count)
        {
            Vm.SelectedLayerFilter = Vm.LayerFilters[index];
        }
    }

    private void SortBy(string column)
    {
        if (_sort == column)
        {
            // Ascending, descending, then back to the trace's order.
            if (_descending)
            {
                _sort = null;
                _descending = false;
            }
            else
            {
                _descending = true;
            }
        }
        else
        {
            _sort = column;
            _descending = false;
        }
    }

    private string AriaSort(string column) => _sort != column ? "none" : _descending ? "descending" : "ascending";
}
