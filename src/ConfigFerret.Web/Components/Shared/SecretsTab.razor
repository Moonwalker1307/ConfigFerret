<div class="column pad-top">
    <div class="legend">
        <span><span class="dot on"></span> In a secret store</span>
        <span><span class="dot check"></span> Check: in doubt</span>
        <span><span class="dot bad"></span> Exposed in plain configuration</span>
    </div>
    <div class="card list-card">
        @if (Vm.SecretRows.Count == 0)
        {
            <div class="empty">
                <Icon Name="IconShield" Size="32" Class="good-text" />
                <span class="muted">Nothing here looks like a secret.</span>
            </div>
        }
        else
        {
            <ul class="rows">
                @foreach (var row in Vm.SecretRows)
                {
                    <li class="secret-row">
                        <span class="stripe @row.Css"></span>
                        <span class="rating @row.Css">@row.Label</span>
                        <div class="row-text">
                            <div class="mono bold">@row.Key</div>
                            <div>@row.Reason</div>
                            <div class="muted small ellipsis">@row.Where</div>
                        </div>
                        <button class="link" @onclick="() => Vm.ShowKeyCommand.Execute(row.Key)">Show</button>
                    </li>
                }
            </ul>
        }
    </div>
</div>

@code {
    /// <summary>The view model.</summary>
    [Parameter, EditorRequired]
    public required MainWindowViewModel Vm { get; set; }
}
