<div class="column pad-top">
    <p class="muted">
        Dead variables are set but nothing reads them: settings no code reads, Helm values no template reads, GitHub variables no
        setting or workflow uses, and Octopus variables no setting uses. Overridden values are set but a later layer always wins. Check other environments before deleting.
    </p>
    <div class="filters">
        <button class="pill @(Vm.OnlyDead ? "checked" : null)" aria-pressed="@(Vm.OnlyDead ? "true" : "false")" @onclick="() => Vm.OnlyDead = !Vm.OnlyDead">
            Dead only <span class="bad-text bold">@Vm.DeadCount</span>
        </button>
        <span class="muted">@Vm.NeverWinsCount overridden</span>
        <span class="muted small">@Vm.DeadScanText</span>
    </div>
    <div class="card list-card">
        @if (Vm.Unused.Count == 0)
        {
            <div class="empty">
                <Icon Name="IconSleep" Size="28" Class="muted" />
                <span class="muted">Everything here is used.</span>
            </div>
        }
        else
        {
            <ul class="rows">
                @foreach (var row in Vm.Unused)
                {
                    <li class="unused-row">
                        <span>
                            @if (row.IsDead)
                            {
                                <span class="chip bad">DEAD</span>
                            }
                            else
                            {
                                <span class="chip">never wins</span>
                            }
                        </span>
                        <span><span class="chip @row.Css">@row.Kind</span></span>
                        <div class="row-text">
                            <div class="mono bold">@row.Name</div>
                            <div class="muted small">@row.Where  ·  @row.Detail</div>
                        </div>
                        @if (row.CanShow)
                        {
                            <button class="link" @onclick="() => Vm.ShowKeyCommand.Execute(row.Name)">Show</button>
                        }
                        else
                        {
                            <span></span>
                        }
                    </li>
                }
            </ul>
        }
    </div>
</div>

@code {
    /// <summary>The view model.</summary>
    [Parameter, EditorRequired]
    public required MainWindowViewModel Vm { get; set; }
}
