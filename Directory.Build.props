<Project>
  <PropertyGroup>
    <!-- net11.0 needs the .NET 11 SDK. Pass -p:TargetFrameworks=net10.0 to build with only the .NET 10 SDK. -->
    <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Authors>RT</Authors>
    <Copyright>Copyright (c) 2026 Mr. T</Copyright>
    <RepositoryUrl>https://github.com/Moonwalker1307/ConfigFerret</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
