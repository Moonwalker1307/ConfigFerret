{
  "stryker-config": {
    "project": "ConfigFerret.Desktop.csproj",
    "test-projects": [ "ConfigFerret.Desktop.Tests.csproj" ],
    "target-framework": "net10.0",
    "test-runner": "mtp",
    "mutate": [
      "**/Services/*.cs",
      "**/Model/*.cs",
      "**/ViewModels/SettingRow.cs",
      "**/ViewModels/Rows.cs",
      "**/Credentials/ICredentialStore.cs"
    ],
    "reporters": [ "html", "json", "progress", "cleartext" ],
    "thresholds": { "high": 80, "low": 60, "break": 0 }
  }
}
