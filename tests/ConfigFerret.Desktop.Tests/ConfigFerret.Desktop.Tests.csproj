<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The desktop app has one target framework. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xunit.v3 test projects build as executables. -->
    <OutputType>Exe</OutputType>
    <!-- Test names read better with underscores. -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CA1861;CA2000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <!-- Stays on xunit.v3 3.x: Avalonia.Headless.XUnit 12.1.6 calls an xunit 3 API that xunit 4 removed, so every
         [AvaloniaFact] fails discovery with a MissingMethodException. Move to 4.x when Avalonia ships a build for it. -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="All" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.6" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.6" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ConfigFerret.Desktop/ConfigFerret.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- A fake repository: its code is test data, not part of the tests. -->
    <Compile Remove="TestData/**" />
    <Compile Remove="Stryker/**" />
    <None Include="TestData/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="TestData/**/.github/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
