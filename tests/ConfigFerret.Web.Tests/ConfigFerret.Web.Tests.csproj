<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The web app has one target framework. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xunit.v3 test projects build as executables. -->
    <OutputType>Exe</OutputType>
    <!-- Test names read better with underscores. -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CA2000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="All" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ConfigFerret.Web/ConfigFerret.Web.csproj" />
  </ItemGroup>

</Project>
