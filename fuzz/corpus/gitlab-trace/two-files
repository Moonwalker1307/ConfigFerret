Avariables:
  DB_TIMEOUT: "15"
  ALIAS: $DB_TIMEOUT

deploy:
  environment: production
  variables:
    DB_PASSWORD: ${DB_PASSWORD}
  script:
    - export Db__Timeout=$ALIAS
    - SMTP_AUTH=$SMTP_PASSWORD ./run.sh

